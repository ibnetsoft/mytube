        {
          "scene_order": 1,
          "scene_id": "E02_S01",
          "block_id": null,
          "quote": "짧은 칼끝이 틈 안으로 들어갔습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E02_S01",
          "block_id": null,
          "quote": "돌과 쇠가 맞물리며 손잡이가 서진의 손바닥을 파고들었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E02_S01",
          "block_id": null,
          "quote": "돌아오던 손목이 덜컥 멎었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E02_S01",
          "block_id": null,
          "quote": "머리 위의 거대한 팔도 한순간 붙들렸습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E02_S01",
          "block_id": null,
          "quote": "서진이 밀어낸 게 아니었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E02_S01",
          "block_id": null,
          "quote": "검 끝은 여전히 그의 발 바로 뒤에 있었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E02_S02",
          "block_id": null,
          "quote": "손목 위의 팔은 멈추지 않았습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E02_S02",
          "block_id": null,
          "quote": "어깨가 내려오자 얇은 칼날부터 휘었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E02_S02",
          "block_id": null,
          "quote": "서진은 손잡이를 잡아당기며 몸을 던졌습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E02_S02",
          "block_id": null,
          "quote": "빠져나온 칼끝에서 쇳가루가 떨어졌고, 뒤늦게 돌아간 돌검이 방금 있던 바닥을 눌렀습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E02_S02",
          "block_id": null,
          "quote": "옆구리가 접히며 숨이 끊겼습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E02_S02",
          "block_id": null,
          "quote": "벌어놓은 시간은 몸 하나 빼낼 만큼이었습니다.",
          "formal_korean_ending": true
        }
      ],
