      "formal_examples": [
        {
          "scene_order": 1,
          "scene_id": "E01_S01",
          "block_id": null,
          "quote": "돌문이 열렸을 때, 밖에서 기다리던 사람들은 검부터 세었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E01_S01",
          "block_id": null,
          "quote": "검이 여섯 자루 돌아왔으니 무사한 탐사였다고 했습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E01_S01",
          "block_id": null,
          "quote": "마지막으로 나온 서진의 등에는 지게가 두 개 겹쳐 있었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 1,
          "scene_id": "E01_S01",
          "block_id": null,
          "quote": "들어갈 때 그중 하나를 메고 있던 사람은 끝내 나오지 않았습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E01_S02",
          "block_id": null,
          "quote": "중개소 서리는 지게를 확인하고 동전을 밀어 주었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E01_S02",
          "block_id": null,
          "quote": "서진은 받지 않고 손가락으로 장부의 다른 이름을 짚었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 2,
          "scene_id": "E01_S02",
          "block_id": null,
          "quote": "그 이름 옆에도 품삯이 적혀 있었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 3,
          "scene_id": "E01_S03",
          "block_id": null,
          "quote": "서진은 자기 몫의 절반을 따로 쌌습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 3,
          "scene_id": "E01_S03",
          "block_id": null,
          "quote": "박 노인의 집에 가져갈 돈이었습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 3,
          "scene_id": "E01_S03",
          "block_id": null,
          "quote": "도겸은 그걸 보고도 말리지 않았습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 3,
          "scene_id": "E01_S03",
          "block_id": null,
          "quote": "대신 물주머니를 건네고, 지게 끈에 눌려 터진 어깨를 살폈습니다.",
          "formal_korean_ending": true
        },
        {
          "scene_order": 3,
          "scene_id": "E01_S03",
          "block_id": null,
          "quote": "도겸은 웃었지만 서진은 웃지 않았습니다.",
          "formal_korean_ending": true
        }
      ],
