# Configure trusted worker credentials locally; never distribute real values.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional stable identity. Use a DIFFERENT value on every computer.
# AIR_SCRIPT_WORKER_ID=studio-mac-01
# Optional writable state directory, independent of the source installation.
# AIRWORKER_HOME=C:/Users/yourname/AppData/Local/AIRStudio/AIRWorker
