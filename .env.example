# ===========================================
# wingsAIStudio 환경 설정
# ===========================================
# 이 파일을 복사하여 .env 로 저장하고 실제 API 키를 입력하세요

# Google API (필수)
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Content generation is delegated to the locally authenticated Codex CLI.
# Gemini remains limited to YouTube/web research in the Hermes pipeline.
CONTENT_GENERATION_ENGINE=codex
# CODEX_EXECUTABLE=codex
# CODEX_CONTENT_MODEL=
# CODEX_CONTENT_TIMEOUT_SECONDS=1800

# TTS API (선택)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TYPECAST_API_KEY=your_typecast_api_key_here

# 상주 Codex 워커: Gemini 웹 나레이션 + ElevenLabs 대사 (최초 전용 Chrome 로그인 필요)
GEMINI_WEB_NARRATION_ENABLED=0
# 따옴표 대사의 기본 ElevenLabs 보이스. 여러 화자는 audio_segments의 voice_id 사용.
# GEMINI_DIALOGUE_VOICE_ID=

# Official Vertex Gemini TTS: use a project billed to the credit-bearing account.
VOICE_STUDIO_ENABLED=0
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Use ADC or a locally managed GOOGLE_APPLICATION_CREDENTIALS path, never chat-pasted keys.
# VOICE_STUDIO_CONFIG=C:/path/to/voice-presets.json

# Voicebox 로컬 TTS (선택 - docs.voicebox.sh, 별도 앱 실행 필요, 인증 없음)
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_ENGINE=qwen
VOICEBOX_MODEL_SIZE=1.7B

# 서버 설정
HOST=127.0.0.1
PORT=8000
DEBUG=true
