# ===========================================
# wingsAIStudio 환경 설정
# ===========================================
# 이 파일을 복사하여 .env 로 저장하고 실제 API 키를 입력하세요

# Google API (필수)
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# TTS API (선택)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TYPECAST_API_KEY=your_typecast_api_key_here

# Voicebox 로컬 TTS (선택 - docs.voicebox.sh, 별도 앱 실행 필요, 인증 없음)
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_ENGINE=qwen
VOICEBOX_MODEL_SIZE=1.7B

# 서버 설정
HOST=127.0.0.1
PORT=8000
DEBUG=true
