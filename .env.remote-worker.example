NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. If blank, the worker uses values loaded from web-admin global settings.
REMOTE_RENDER_WORKER_ID=render-pc-01
REMOTE_RENDER_POLL_INTERVAL=10
REMOTE_RENDER_DRIVE_FOLDER_ID=
REMOTE_RENDER_GOOGLE_TOKEN_PATH=C:/AIR/token.json

# GPU Encoding
# Set to true on PCs with an NVIDIA GPU (RTX 20xx or later).
# The worker auto-detects h264_nvenc via `ffmpeg -encoders`.
# Falls back to CPU (libx264) automatically if NVENC is unavailable or fails.
USE_GPU_RENDER=true
