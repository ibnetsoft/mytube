{
  "manifest_version": 3,
  "name": "AIR Gemini Narrator",
  "version": "0.1.0",
  "description": "Gemini 웹의 읽어주기를 AIR 나레이션 파일로 저장하는 실험용 확장 프로그램",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "AIR 나레이션 패널 열기"},
  "content_scripts": [
    {"matches": ["https://gemini.google.com/*"], "js": ["audio-hook.js"], "world": "MAIN", "run_at": "document_start"},
    {"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}
  ]
}
